#!/usr/bin/env python3
import argparse
import os
import shutil
import subprocess
import sys
import time
import urllib.request
import urllib.error
import zipfile
from pathlib import Path


def get_server_port(name):
    """Получить порт сервера по имени из .port файла"""
    port_file = Path(name) / '.port'
    if port_file.exists():
        try:
            return int(port_file.read_text().strip())
        except ValueError:
            return None
    return None


def get_all_servers():
    """Получить список всех запущенных серверов, отсортированный лексикографически"""
    servers = []
    for item in Path('.').iterdir():
        if item.is_dir() and (item / 'server.py').exists():
            servers.append(item.name)
    return sorted(servers)


def is_port_in_use(port):
    """Проверить, занят ли порт каким-либо процессом"""
    import socket
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(1)
        return s.connect_ex(('localhost', port)) == 0


def kill_server_process(name, port):
    """Убить процесс сервера через tmux"""
    # Сначала пробуем отправить Ctrl+C в tmux окно
    subprocess.run(
        ['tmux', 'send-keys', '-t', f'homework:{name}', 'C-c'],
        capture_output=True
    )
    time.sleep(0.3)
    
    # Если не помогло, убиваем по порту через fuser
    if port:
        subprocess.run(
            ['fuser', '-k', f'{port}/tcp'],
            capture_output=True
        )
    time.sleep(0.2)


def start_server(name, port):
    # Проверка: существует ли уже сервер с таким именем (exit 1)
    if Path(name).exists() and (Path(name) / 'server.py').exists():
        sys.exit(1)

    # Проверка: существует ли сервер с таким портом (exit 2)
    for server_name in get_all_servers():
        if get_server_port(server_name) == port:
            sys.exit(2)

    # Проверка: порт занят другим (не нашим сервером) процессом (exit 3)
    if is_port_in_use(port):
        sys.exit(3)

    # Создание папки
    Path(name).mkdir(parents=True, exist_ok=True)

    # Копирование server.py из текущей директории (где лежит homework)
    source_server = Path('server.py')
    if not source_server.exists():
        print("server.py not found", file=sys.stderr)
        shutil.rmtree(name, ignore_errors=True)
        sys.exit(1)
    shutil.copy(source_server, Path(name) / 'server.py')

    # Сохранение порта
    (Path(name) / '.port').write_text(str(port))

    # Команда для запуска сервера внутри папки с редиректом stdout
    server_cmd = f"python3 server.py --port {port} > out.txt"

    # Проверка, существует ли tmux-сессия homework
    has_session = subprocess.run(
        ['tmux', 'has-session', '-t', 'homework'],
        capture_output=True
    )

    if has_session.returncode != 0:
        # Создаём сессию сразу с окном нашего сервера (без дефолтного окна)
        subprocess.run(
            ['tmux', 'new-session', '-d', '-s', 'homework', '-n', name,
             f'cd {name} && {server_cmd}'],
            capture_output=True
        )
    else:
        # Сессия уже есть — добавляем новое окно
        subprocess.run(
            ['tmux', 'new-window', '-t', 'homework', '-n', name,
             f'cd {name} && {server_cmd}'],
            capture_output=True
        )

    # Ждём 3 секунды для запуска сервера
    time.sleep(3)

    # Проверка healthcheck (продвинутый поток)
    try:
        response = urllib.request.urlopen(
            f'http://localhost:{port}/healthcheck',
            timeout=5
        )
        code = response.getcode()
        if code != 200:
            print(f"Bad response code: {code}", file=sys.stderr)
            sys.exit(4)
    except urllib.error.HTTPError as e:
        print(f"Bad response code: {e.code}", file=sys.stderr)
        sys.exit(4)
    except Exception:
        # Сервер не запустился или не отвечает - выходим с 4
        sys.exit(4)


def stop_server(name):
    server_dir = Path(name)

    # Проверка, что сервер существует
    if not server_dir.exists() or not (server_dir / 'server.py').exists():
        return

    # Получение порта
    port = get_server_port(name)

    # Остановка процесса (передаём name для tmux)
    kill_server_process(name, port)

    # Бэкап out.txt
    backup_dir = Path('.backup')
    backup_dir.mkdir(exist_ok=True)

    out_file = server_dir / 'out.txt'
    if out_file.exists():
        timestamp = int(time.time())
        backup_name = f'out_{name}_{timestamp}.txt'
        shutil.copy(out_file, backup_dir / backup_name)

    # Закрытие tmux-окна
    subprocess.run(
        ['tmux', 'kill-window', '-t', f'homework:{name}'],
        capture_output=True
    )

    # Удаление папки сервера
    shutil.rmtree(server_dir, ignore_errors=True)


def stop_all():
    servers = get_all_servers()

    # Остановка каждого сервера
    for name in servers:
        port = get_server_port(name)
        kill_server_process(name, port)

    # Небольшая пауза, чтобы все процессы завершились
    if servers:
        time.sleep(0.5)

    # Бэкап out.txt и удаление папок
    backup_dir = Path('.backup')
    backup_dir.mkdir(exist_ok=True)

    for name in servers:
        server_dir = Path(name)
        out_file = server_dir / 'out.txt'
        if out_file.exists():
            timestamp = int(time.time())
            backup_name = f'out_{name}_{timestamp}.txt'
            shutil.copy(out_file, backup_dir / backup_name)
        shutil.rmtree(server_dir, ignore_errors=True)

    # Закрытие всей tmux-сессии
    subprocess.run(
        ['tmux', 'kill-session', '-t', 'homework'],
        capture_output=True
    )


def collect_all(zip_mode=False):
    servers = get_all_servers()

    if zip_mode:
        timestamp = int(time.time())
        zip_name = f'out_{timestamp}.zip'

        with zipfile.ZipFile(zip_name, 'w', zipfile.ZIP_DEFLATED) as zf:
            for name in servers:
                out_file = Path(name) / 'out.txt'
                if out_file.exists():
                    zf.write(out_file, f'out_{name}.txt')
    else:
        for i, name in enumerate(servers):
            out_file = Path(name) / 'out.txt'
            # Заголовок блока
            print(f"=== server: {name} ===")
            print()
            # Содержимое файла (с удалением завершающих \n)
            if out_file.exists():
                content = out_file.read_text()
                # Убираем завершающие переносы, чтобы не было лишних пустых строк
                content = content.rstrip('\n')
                if content:
                    print(content)
            # Пустая строка между блоками (кроме последнего)
            if i < len(servers) - 1:
                print()


def main():
    parser = argparse.ArgumentParser(description='Homework server manager')
    subparsers = parser.add_subparsers(dest='command')

    start_parser = subparsers.add_parser('start')
    start_parser.add_argument('--name', required=True)
    start_parser.add_argument('--port', type=int, required=True)

    stop_parser = subparsers.add_parser('stop')
    stop_parser.add_argument('--name', required=True)

    subparsers.add_parser('stop_all')

    collect_parser = subparsers.add_parser('collect_all')
    collect_parser.add_argument('--zip', action='store_true')

    args = parser.parse_args()

    if args.command == 'start':
        start_server(args.name, args.port)
    elif args.command == 'stop':
        stop_server(args.name)
    elif args.command == 'stop_all':
        stop_all()
    elif args.command == 'collect_all':
        collect_all(args.zip)
    else:
        parser.print_help()


if __name__ == '__main__':
    main()
